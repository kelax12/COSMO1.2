{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* TypeScript 6 ne charge plus tous les @types par défaut (`types` vaut [])
       : celui de Node était implicite, il devient explicite. */
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    /* Catalogues i18n : src/locales/<locale>/*.json sont importés comme des
       modules typés. Le format JSON (et non .ts) est imposé par le prérendu (prerender/),
       du Node sans bundler, qui doit lire les mêmes fichiers. */
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias. Sans `baseUrl` (déprécié en TypeScript 6, supprimé en 7) :
       `paths` se résout alors par rapport à ce fichier. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "prerender"]
}
