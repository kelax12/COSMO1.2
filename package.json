{
  "name": "cosmo-task-manager",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "start:lan": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "build": "vite build && node scripts/third-party-notices.mjs && node prerender.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "check:rls": "node scripts/check-rls-advisors.mjs",
    "check:drift": "node scripts/check-prod-drift.mjs",
    "check:migration-coverage": "node scripts/check-migration-coverage.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "cosmo": "node scripts/cosmo/cli.mjs",
    "cosmo:login": "node scripts/cosmo/login.mjs",
    "test:rls": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:identical": "node scripts/i18n-identical.mjs",
    "i18n:namespaces": "node scripts/i18n-shell-namespaces.mjs",
    "profile:landing": "node scripts/profile-landing.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "analyze:entry": "node scripts/analyze-entry.mjs",
    "images:check": "node scripts/optimize-images.mjs --check",
    "check:legal": "node scripts/check-legal-table.mjs",
    "check:mail": "node scripts/check-auth-email.mjs",
    "check:edge": "node scripts/check-edge-deploy.mjs",
    "check:docs": "node scripts/check-docs-budget.mjs",
    "check:deploy": "node scripts/check-deploy-sha.mjs",
    "test:coverage:tooling": "vitest run --config vitest.tooling.config.ts --coverage && node scripts/check-tooling-coverage.mjs",
    "check:edge-coverage": "node scripts/edge-function-coverage.mjs",
    "check:tooling-coverage": "node scripts/check-tooling-coverage.mjs",
    "check:test-floor": "node scripts/check-test-floor.mjs",
    "check:sabotages": "node scripts/replay-sabotages.mjs",
    "check:seo": "node scripts/check-seo-pages.mjs",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "check:study": "node scripts/check-study-freshness.mjs",
    "check:legal-journal": "node scripts/check-legal-journal.mjs",
    "check:erasure": "node scripts/check-erasure-coverage.mjs",
    "check:portability": "node scripts/check-portability-export.mjs",
    "check:env": "node scripts/check-env-contract.mjs",
    "check:edge-smoke": "node scripts/check-edge-smoke.mjs",
    "check:supabase-posture": "node scripts/check-supabase-posture.mjs",
    "check:retention": "node scripts/check-retention.mjs",
    "check:db-cost": "node scripts/check-db-cost.mjs",
    "check:stripe-prices": "node scripts/check-stripe-prices.mjs",
    "i18n:pages": "node scripts/check-i18n-pages.mjs",
    "check:keyboard-coverage": "vitest run src/keyboard-audit-coverage.guard.test.ts",
    "check:acquisition": "node scripts/check-acquisition.mjs",
    "check:docs-scored": "node scripts/check-docs-scored.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.10",
    "@fullcalendar/daygrid": "^6.1.10",
    "@fullcalendar/interaction": "^6.1.10",
    "@fullcalendar/react": "^6.1.10",
    "@fullcalendar/timegrid": "^6.1.10",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.25",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.34.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.563.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.10",
    "shadcn": "^4.18.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.11"
  }
}
