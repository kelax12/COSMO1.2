{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 2,
      "url": [
        "http://localhost/",
        "http://localhost/guide/",
        "http://localhost/blog/",
        "http://localhost/pour-freelances/"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --lang=fr-FR --accept-lang=fr-FR"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.92 }],
        "categories:best-practices": ["error", { "minScore": 0.97 }],
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 1700 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "unused-javascript": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
