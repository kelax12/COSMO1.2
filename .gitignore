# Config du CLI agent COSMO (scripts/cosmo/) — contient l'URL + la clé
# publishable du projet Supabase. Volontairement distinct de .env, dont le
# VITE_SUPABASE_URL vide maintient l'app locale en mode démo.
.env.cosmo-cli
# Acces IMAP a contact@thecosmo.app + webhook Discord (scripts/mail/).
.env.mail

# Deepsec scanner workspace — local-only, contains ANTHROPIC_API_KEY
.deepsec/

# Playwright artefacts
/test-results/
/playwright-report/
/playwright/.cache/
.playwright/
.playwright-cli/

# Visual audit artefacts (PNG captures + autonomous HTML report — local tooling, not app code)
visual-audit/
visual-audit-before/
visual-audit*.log

# Skill framework artifacts (local tooling, not app code)
.agents/
.claude/skills/
skills-lock.json

# Captures d audit visuel locales (jamais versionnees)
visual-audit-*/

# Cache de l outil graphify (AST, index, rapports générés — pas du code)
graphify-out/

# Rapports Lighthouse CI (regeneres a chaque run)
.lighthouseci/

# Sorties d outillage local : logs de vitest/playwright, copies de deploiement,
# critiques du skill impeccable. Toutes reproductibles par une commande, aucune
# n est une preuve : le drift des Edge Functions se mesure par `npm run check:edge`,
# jamais en relisant une copie laissee sur le disque (elle perime en silence).
.tmp-*
full-run.txt
.deploy-tmp/
.impeccable/

# C-82 — rapport de couverture de l outillage (scripts/), config jumelle
# vitest.tooling.config.ts. Meme raison que `coverage/` : c est un artefact.
coverage-tooling
.lighthouseci-mobile

# Artefacts locaux rangés hors racine (2026-10-11)
.artifacts/

# Test de mutation (AM-3) : rapport Stryker et bac a sable.
/reports
.stryker-tmp

# Documents prives (depot PUBLIC) : prospection et business plan restent en local.
/leads-*.csv
/docs/business-plan/
# Depot PUBLIC : `prive/` est le dossier LOCAL du checkout principal (faille.md,
# a-faire-manuel.md, RGPD-VIOLATION.md, prospection, audit). Jamais publie ;
# le hook pre-commit et la CI le refusent aussi (check-fichiers-sensibles.mjs).
/prive/

# Fichiers locaux d'outillage (SEC-07) : reglages d'agent du poste, etat du CLI
# Supabase (pooler, project-ref). Retires du suivi le 2026-11-06.
/.claude/settings.local.json
/supabase/.temp/

# Etat des seances de brainstorm superpowers.
/.superpowers/

# Sortie locale de scripts/contrat-donnees.mjs --verifier --sortie
contrat-donnees-genere/
supabase.env
